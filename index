    <!-- Tailwind CSS for rapid modern layout -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            500: '#10b981',
                            600: '#059669',
                            900: '#064e3b',
                        },
                        accent: {
                            gold: '#f59e0b',
                            cyan: '#06b6d4',
                            emerald: '#10b981'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans KR', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css');
        
        :root {
            --bg-main: #f8fafc;
            --text-main: #1e293b;
            --text-sub: #475569;
            --glass-bg: rgba(255, 255, 255, 0.85);
            --glass-border: rgba(0, 0, 0, 0.08);
            --card-sub-bg: rgba(241, 245, 249, 0.8);
            --header-bg: rgba(248, 250, 252, 0.85);
            --glow-color: rgba(16, 185, 129, 0.12);
        }

        html.dark {
            --bg-main: #0d1117;
            --text-main: #c9d1d9;
            --text-sub: #9ca3af;
            --glass-bg: rgba(22, 27, 34, 0.75);
            --glass-border: rgba(255, 255, 255, 0.08);
            --card-sub-bg: rgba(13, 17, 23, 0.6);
            --header-bg: rgba(13, 17, 23, 0.85);
            --glow-color: rgba(16, 185, 129, 0.15);
        }

        body {
            font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            border-color: rgba(16, 185, 129, 0.4);
            box-shadow: 0 12px 40px 0 rgba(16, 185, 129, 0.15);
        }

        .theme-sub-card {
            background-color: var(--card-sub-bg);
        }

        .gradient-text {
            background: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #f59e0b 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        html.dark .gradient-text {
            background: linear-gradient(135deg, #34d399 0%, #38bdf8 50%, #fbbf24 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glow-effect {
            position: absolute;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, var(--glow-color) 0%, rgba(0, 0, 0, 0) 70%);
            top: -50px;
            left: -50px;
            pointer-events: none;
            border-radius: 50%;
        }

        summary::-webkit-details-marker {
            display: none;
        }

        summary {
            list-style: none;
        }
    </style>
</head>
<body class="min-h-screen antialiased selection:bg-emerald-500 selection:text-black">

    <header class="sticky top-0 z-50 backdrop-blur-md border-b border-gray-200 dark:border-gray-800/80 transition-colors" style="background-color: var(--header-bg)">
        <div class="max-w-5xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
            <a href="#" class="text-xl font-bold tracking-tight text-gray-900 dark:text-white flex items-center gap-2 group">
                <span class="w-3 h-3 rounded-full bg-emerald-500 dark:bg-emerald-400 group-hover:animate-ping"></span>
                <span>신재원<span class="text-emerald-600 dark:text-emerald-400">.value</span></span>
            </a>
            
            <div class="flex items-center gap-2 sm:gap-4">
                <nav>
                    <ul class="flex flex-wrap items-center gap-1 sm:gap-2 text-sm font-medium text-gray-600 dark:text-gray-400">
                        <li><a href="#about" class="px-2.5 py-1.5 rounded-lg hover:text-gray-900 dark:hover:text-white hover:bg-gray-200/60 dark:hover:bg-gray-800 transition-all">소개</a></li>
                        <li><a href="#philosophy" class="px-2.5 py-1.5 rounded-lg hover:text-gray-900 dark:hover:text-white hover:bg-gray-200/60 dark:hover:bg-gray-800 transition-all">가치관</a></li>
                        <li><a href="#focus" class="px-2.5 py-1.5 rounded-lg hover:text-gray-900 dark:hover:text-white hover:bg-gray-200/60 dark:hover:bg-gray-800 transition-all">관심 분야</a></li>
                        <li><a href="#goals" class="px-2.5 py-1.5 rounded-lg hover:text-gray-900 dark:hover:text-white hover:bg-gray-200/60 dark:hover:bg-gray-800 transition-all">비전</a></li>
                        <li><a href="#contact" class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500 hover:text-white dark:hover:text-black transition-all">연락하기</a></li>
                    </ul>
                </nav>

                <!-- Dark / Light Theme Toggle Button -->
                <button id="theme-toggle" type="button" aria-label="테마 전환"
                        class="p-2 rounded-xl bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-700 transition-all focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <!-- Sun Icon (shown in dark mode) -->
                    <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
                    </svg>
                    <!-- Moon Icon (shown in light mode) -->
                    <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-12 space-y-24">

        <section id="hero" class="relative pt-8 pb-4">
            <div class="glow-effect"></div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold mb-6">
                <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
                경제적 가치와 효율적 성장을 탐구하는 사람
            </div>
            
            <h1 class="text-4xl sm:text-6xl font-extrabold text-gray-900 dark:text-white tracking-tight leading-tight mb-6">
                돈의 흐름을 파악하고 <br class="hidden sm:inline">
                <span class="gradient-text">나만의 자산적 가치</span>를 만드는 신재원입니다.
            </h1>
            
            <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl leading-relaxed mb-8">
                단순한 소유보다 지식과 경제적 구조를 파고듭니다. 효율적인 원리를 비교·분석하여 스스로 선택할 수 있는 삶의 기반을 다집니다.
            </p>

            <div class="flex flex-wrap gap-4">
                <a href="#about" class="px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-500 via-teal-600 to-cyan-600 text-white font-semibold shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all">
                    프로필 보기 &rarr;
                </a>
                <a href="#philosophy" class="px-6 py-3 rounded-xl glass-card text-gray-800 dark:text-gray-200 font-semibold hover:bg-gray-100 dark:hover:bg-gray-800/80 hover:scale-[1.02] active:scale-[0.98] transition-all">
                    나의 가치관 읽기
                </a>
            </div>
        </section>

        <section id="about" class="space-y-6">
            <div class="flex items-center gap-3">
                <span class="text-emerald-600 dark:text-emerald-400 font-mono text-sm">01.</span>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">기본 정보 (Profile)</h2>
                <div class="h-[1px] bg-gray-200 dark:bg-gray-800 flex-1 ml-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-2 glass-card rounded-2xl p-6 space-y-4">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white">"현실적인 결과를 바탕으로 끝까지 파고듭니다."</h3>
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-base">
                        안녕하세요, <strong>신재원</strong>입니다. 저는 돈이 어떻게 움직이고, 사람들이 어떤 방식으로 자산을 모으고 불려 나가는지에 깊은 관심을 가지고 있습니다.
                    </p>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
                        새로운 정보를 얻을 때 단순히 사실에 머무르지 않고, 이 정보가 실제로 어떤 <strong>경제적 가치</strong>로 환산될 수 있을지 고민합니다. 소비와 투자, 수입과 지출의 메커니즘을 객관적으로 관찰하며 나만의 명확한 판단 기준을 구축해 나가고 있습니다.
                    </p>
                </div>

                <div class="glass-card rounded-2xl p-6 space-y-3 border-l-4 border-l-emerald-500 dark:border-l-emerald-400">
                    <h3 class="text-xs uppercase tracking-wider font-semibold text-gray-500 dark:text-gray-400">인적 사항</h3>
                    <ul class="space-y-3 text-sm">
                        <li class="flex justify-between py-1 border-b border-gray-200 dark:border-gray-800">
                            <span class="text-gray-500">이름</span>
                            <span class="font-semibold text-gray-900 dark:text-white">신재원</span>
                        </li>
                        <li class="flex justify-between py-1 border-b border-gray-200 dark:border-gray-800">
                            <span class="text-gray-500">생년월일</span>
                            <span class="text-gray-700 dark:text-gray-300">2003년 8월 30일</span>
                        </li>
                        <li class="flex justify-between py-1 border-b border-gray-200 dark:border-gray-800">
                            <span class="text-gray-500">거주지</span>
                            <span class="text-gray-700 dark:text-gray-300">인천광역시 계양구</span>
                        </li>
                        <li class="flex justify-between py-1">
                            <span class="text-gray-500">핵심 관심사</span>
                            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">금융, 투자, 경제적 독립</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <section id="philosophy" class="space-y-6">
            <div class="flex items-center gap-3">
                <span class="text-cyan-600 dark:text-cyan-400 font-mono text-sm">02.</span>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">태도와 가치관 (Mindset)</h2>
                <div class="h-[1px] bg-gray-200 dark:bg-gray-800 flex-1 ml-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="glass-card rounded-2xl p-6 space-y-3 hover:border-emerald-500/40 transition-all">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 font-bold text-lg mb-2">01</div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">이해할 때까지 파고드는 성격</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        한 가지 주제에 호기심이 생기면 겉핥기식에 그치지 않습니다. 직접 찾아보고 수치를 비교하면서 완벽히 이해할 때까지 집요하게 탐구합니다.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="glass-card rounded-2xl p-6 space-y-3 hover:border-cyan-500/40 transition-all">
                    <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-500 font-bold text-lg mb-2">02</div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">효율성과 최적화 지향</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        같은 시간과 노력을 투입하더라도 더 정교하고 우수한 결과를 도출할 수 있는 방식을 고안하고 개선하는 것을 즐깁니다.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="glass-card rounded-2xl p-6 space-y-3 hover:border-amber-500/40 transition-all">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500 font-bold text-lg mb-2">03</div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">주도적인 삶과 경제적 독립</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        돈에 대한 관심은 탐욕이 아닌, 내가 원하는 삶의 방식을 스스로 선택할 수 있는 자율성과 경제적 주권을 갖추기 위함입니다.
                    </p>
                </div>
            </div>
        </section>

        <section id="focus" class="space-y-6">
            <div class="flex items-center gap-3">
                <span class="text-amber-600 dark:text-amber-400 font-mono text-sm">03.</span>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">핵심 관심 분야 (Focus Areas)</h2>
                <div class="h-[1px] bg-gray-200 dark:bg-gray-800 flex-1 ml-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Interest Box 1 -->
                <div class="glass-card rounded-2xl p-6 space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> 금융 및 경제 메커니즘
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        돈의 유동성과 자본시장의 생태계를 다각도로 공부합니다. 개별 경제 주체가 자산을 불리는 구조적 차이에 주목합니다.
                    </p>
                    <div class="flex flex-wrap gap-2 pt-2">
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">자산 흐름 분석</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">금융 지식</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">시장 모니터링</span>
                    </div>
                </div>

                <!-- Interest Box 2 -->
                <div class="glass-card rounded-2xl p-6 space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span> 수입·지출 & 투자 모델링
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                        수입의 다변화 및 현명한 지출 관리를 실천합니다. 데이터 기반으로 소비 패턴을 분석하고 가치 높은 리소스 배분을 고심합니다.
                    </p>
                    <div class="flex flex-wrap gap-2 pt-2">
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">현금 흐름 수립</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">투자 기준 분석</span>
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">리스크 관리</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="goals" class="space-y-6">
            <div class="flex items-center gap-3">
                <span class="text-purple-600 dark:text-purple-400 font-mono text-sm">04.</span>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">목표 및 지향점 (Vision)</h2>
                <div class="h-[1px] bg-gray-200 dark:bg-gray-800 flex-1 ml-4"></div>
            </div>

            <div class="glass-card rounded-2xl p-6 space-y-6">
                <div class="relative border-l-2 border-emerald-500/30 ml-2 pl-6 space-y-8">
                    <!-- Step 1 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-emerald-500 border-4 border-white dark:border-[#0d1117]"></div>
                        <h3 class="text-base font-bold text-gray-900 dark:text-white">다양한 분야에서의 지식 확충</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            금융, 투자, 사업, 경제 전반을 오가며 지식의 폭을 늘리고 실전 감각을 확장합니다.
                        </p>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-cyan-500 border-4 border-white dark:border-[#0d1117]"></div>
                        <h3 class="text-base font-bold text-gray-900 dark:text-white">안정적인 파이프라인 구축 및 자율적 자산 관리</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            장기적으로 축적한 지식과 경험을 체계화하여 지속 가능하고 안정적인 수입을 지속 창출합니다.
                        </p>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative">
                        <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-500 border-4 border-white dark:border-[#0d1117]"></div>
                        <h3 class="text-base font-bold text-gray-900 dark:text-white">나만의 방식으로 실질적 가치 창출</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            현실적인 결과를 바탕으로 꾸준히 성과를 내며, 주체적인 경제 활동을 완성합니다.
                        </p>
                    </div>
                </div>

                <details class="group border-t border-gray-200 dark:border-gray-800 pt-4">
                    <summary class="cursor-pointer text-sm font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-2 hover:underline">
                        <span>신재원 님의 다짐 자세히 보기</span>
                        <span class="group-open:rotate-180 transition-transform text-xs">▼</span>
                    </summary>
                    <div class="mt-4 p-4 rounded-xl theme-sub-card text-sm text-gray-700 dark:text-gray-300 leading-relaxed border border-gray-200 dark:border-gray-800">
                        "새로운 것을 배우는 데 거리낌이 없고, 언제나 손에 잡히는 현실적인 성과를 중시합니다. 내가 선택한 분야에서 배움을 멈추지 않고 계속 증명하여 결국 나만의 독창적인 가치를 만들어내겠습니다."
                    </div>
                </details>
            </div>
